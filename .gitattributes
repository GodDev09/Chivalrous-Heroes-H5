# ============================================================
#  Chivalrous-Heroes-H5 (XxSG) — Git LFS
# ============================================================
# Nguyên tắc chọn pattern:
#   TRACK   = binary lớn, không bao giờ diff có ý nghĩa
#   KHÔNG   = file text cần diff/merge (JSON cấu hình gameplay,
#             PHP, SVG), và file binary nhỏ nhưng rất nhiều
#             (*.class ~3 KB/file × 6094 file — pointer LFS
#             130 byte không tiết kiệm gì, chỉ thêm 6094 object)
#
# ⚠️  Tổng dung lượng vào LFS ≈ 735 MB. GitHub free chỉ cho
#     1 GB storage + 1 GB bandwidth/tháng → xem README §10.
# ============================================================


# ------------------------------------------------------------
# Ảnh — 346 MB .png + 58 MB .jpg + 36 MB .psd + 4 MB .gif
# ------------------------------------------------------------
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
*.jpeg      filter=lfs diff=lfs merge=lfs -text
*.gif       filter=lfs diff=lfs merge=lfs -text
*.bmp       filter=lfs diff=lfs merge=lfs -text
*.webp      filter=lfs diff=lfs merge=lfs -text
*.tga       filter=lfs diff=lfs merge=lfs -text
*.ico       filter=lfs diff=lfs merge=lfs -text
*.psd       filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------
# Java dependency — 173 MB / 201 jar (tools.jar 17.4 MB × 3)
# ------------------------------------------------------------
*.jar       filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------
# Bundle JS đã minify — 19 MB, coi như binary (không diff được)
# Không track *.js chung: hgavnh.js / index.js là code sửa tay.
# ------------------------------------------------------------
*.min.js    filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------
# JSON khổng lồ do tool sinh — 85 MB / 5 file
# Chỉ định theo đường dẫn cụ thể. Các JSON còn lại (cấu hình
# gameplay, sửa tay thường xuyên) CỐ Ý để nguyên trong git.
# ------------------------------------------------------------
wwwroot/config/cfg.json               filter=lfs diff=lfs merge=lfs -text
wwwroot/config/cfg/cfg.json           filter=lfs diff=lfs merge=lfs -text
**/webgame/data/cn/monster.json       filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------
# Font — 9,5 MB
# ------------------------------------------------------------
*.ttf       filter=lfs diff=lfs merge=lfs -text
*.otf       filter=lfs diff=lfs merge=lfs -text
*.eot       filter=lfs diff=lfs merge=lfs -text
*.woff      filter=lfs diff=lfs merge=lfs -text
*.woff2     filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------
# Âm thanh — 4 MB
# ------------------------------------------------------------
*.mp3       filter=lfs diff=lfs merge=lfs -text
*.ogg       filter=lfs diff=lfs merge=lfs -text
*.wav       filter=lfs diff=lfs merge=lfs -text
*.m4a       filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------
# Binary khác (asset đóng gói Egret / DragonBones)
# ------------------------------------------------------------
*.bin       filter=lfs diff=lfs merge=lfs -text
*.swf       filter=lfs diff=lfs merge=lfs -text
*.fla       filter=lfs diff=lfs merge=lfs -text


# ============================================================
#  CỐ Ý KHÔNG đưa vào LFS
# ============================================================
# *.class  19,7 MB / 6094 file — quá nhỏ, git nén tốt hơn
# *.json   (trừ 5 file trên) — cấu hình gameplay, cần diff
# *.svg    9,9 MB / 3131 file — là text
# *.php *.js *.css *.ts — source code
# ============================================================


# ------------------------------------------------------------
# Chuẩn hoá EOL — repo có script Windows (.bat) và PHP/Java
# KHÔNG thêm `*.js` / `*.json` vào đây: rule sau ghi đè rule
# trước, sẽ bật lại `text` cho *.min.js và cfg.json đang ở LFS
# → git normalize CRLF làm hỏng file binary.
# ------------------------------------------------------------
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.sh        text eol=lf
*.php       text
*.java      text
*.css       text
*.xml       text
*.properties text
