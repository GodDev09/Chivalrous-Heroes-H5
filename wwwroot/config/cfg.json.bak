correctAnswer\":1},\"1010522\":{\"id\":1010522,\"name\":\"“红酥手，黄滕酒，满城春色宫墙柳”这一首词描写的是谁的爱情故事？\",\"answerId\":[1,2,3,4],\"show\":[\"132\",\"陆游\",\"133\",\"134\"],\"correctAnswer\":2},\"1010523\":{\"id\":1010523,\"name\":\"“户枢不蠹”的“不蠹”是什么意思？\",\"answerId\":[1,2,3,4],\"show\":[\"133\",\"134\",\"不生虫\",\"134\"],\"correctAnswer\":3},\"1010524\":{\"id\":1010524,\"name\":\"“几处早莺争暖树，谁家新燕啄春泥”出自哪首诗\",\"answerId\":[1,2,3,4],\"show\":[\"134\",\"135\",\"136\",\"钱塘湖春行\"],\"correctAnswer\":4},\"1010525\":{\"id\":1010525,\"name\":\"“慨当以慷，忧思难忘”作者是？\",\"answerId\":[1,2,3,4],\"show\":[\"曹操\",\"132\",\"133\",\"134\"],\"correctAnswer\":1},\"1010526\":{\"id\":1010526,\"name\":\"“莫道不消魂，帘卷西风，人比（）瘦。”括号内的文字是\",\"answerId\":[1,2,3,4],\"show\":[\"133\",\"黄花\",\"134\",\"135\"],\"correctAnswer\":2},\"1010527\":{\"id\":1010527,\"name\":\"“十年生死两茫茫。不思量，自难忘。千里孤坟，无处话凄凉。”出自苏轼的哪首词\",\"answerId\":[1,2,3,4],\"show\":[\"134\",\"135\",\"江城子\",\"135\"],\"correctAnswer\":3},\"1010528\":{\"id\":1010528,\"name\":\"“危楼高百尺，手可摘星辰”出自李白的哪首诗\",\"answerId\":[1,2,3,4],\"show\":[\"135\",\"136\",\"137\",\"夜宿山寺\"],\"correctAnswer\":4},\"1010529\":{\"id\":1010529,\"name\":\"《长恨歌》中“忽闻海上有仙山”的下句是\",\"answerId\":[1,2,3,4],\"show\":[\"山在虚无缥缈间\",\"133\",\"134\",\"135\"],\"correctAnswer\":1},\"1010530\":{\"id\":1010530,\"name\":\"《诗经》中讽刺剥削者的诗是\",\"answerId\":[1,2,3,4],\"show\":[\"134\",\"《硕鼠》\",\"135\",\"136\"],\"correctAnswer\":2},\"1010531\":{\"id\":1010531,\"name\":\"杜甫诗句“故人入我梦，明我长相忆。君今在罗网，何以有羽翼？”中“故人”是指\",\"answerId\":[1,2,3,4],\"show\":[\"135\",\"136\",\"李白\",\"136\"],\"correctAnswer\":3},\"1010532\":{\"id\":1010532,\"name\":\"古诗词名句“红藕香残玉簟秋”出自南宋著名女词人李清照哪首佳作\",\"answerId\":[1,2,3,4],\"show\":[\"136\",\"137\",\"138\",\"《一剪梅》\"],\"correctAnswer\":4},\"1010533\":{\"id\":1010533,\"name\":\"古诗名句:“梅落繁枝千万片，犹自多情，学雪随风转。”的作者是？\",\"answerId\":[1,2,3,4],\"show\":[\"冯延巳\",\"134\",\"135\",\"136\"],\"correctAnswer\":1},\"1010534\":{\"id\":1010534,\"name\":\"古诗名句:“清瑟怨遥夜”的下句是？\",\"answerId\":[1,2,3,4],\"show\":[\"135\",\"绕弦风雨哀\",\"136\",\"137\"],