\"text\":\"恭喜{playerName}的天金武将{fighterName}升到{num}星！\",\"serverParameter\":\"playerName;fighterName;num\"},\"721\":{\"id\":721,\"text\":\"恭喜{playerName}的暗金武将{fighterName}升到{num}星！\",\"serverParameter\":\"playerName;fighterName;num\"},\"722\":{\"id\":722,\"text\":\"恭喜{playerName}的暗金武将{fighterName}升到满星！\",\"serverParameter\":\"playerName;fighterName\"},\"723\":{\"id\":723,\"text\":\"经过{playerName}精心培育，暗金武将{fighterName}达到200级！\",\"serverParameter\":\"playerName;fighterName\"},\"801\":{\"id\":801,\"text\":\"恭喜{playerName}在充值返利中获得{num}元宝\",\"serverParameter\":\"playerName;num\"},\"802\":{\"id\":802,\"text\":\"{playerName}花费一元购买了{oneyuanName}\",\"serverParameter\":\"playerName;oneyuanName\"},\"803\":{\"id\":803,\"text\":\"{playerName}花费三元购买了{oneyuanName}\",\"serverParameter\":\"playerName;oneyuanName\"},\"804\":{\"id\":804,\"text\":\"{playerName}花费八元购买了{oneyuanName}\",\"serverParameter\":\"playerName;oneyuanName\"},\"805\":{\"id\":805,\"text\":\"{playerName}花费十二元购买了{oneyuanName}\",\"serverParameter\":\"playerName;oneyuanName\"},\"806\":{\"id\":806,\"text\":\"{playerName}花费十八元购买了{oneyuanName}\",\"serverParameter\":\"playerName;oneyuanName\"},\"901\":{\"id\":901,\"text\":\"好友改名通知\",\"serverParameter\":\"\"},\"902\":{\"id\":902,\"text\":\"好友{oldName}改名为{newName}\",\"serverParameter\":\"oldName;newName\"},\"903\":{\"id\":903,\"text\":\"请求协助{militaryName}<clk=military#{playerId}>立即协助</clk>\",\"serverParameter\":\"militaryName;playerId\"},\"904\":{\"id\":904,\"text\":\"{blocName}军团招新了，欢迎各路主公前来加入。<clk=army#{blocId}>立即加入</clk>\",\"serverParameter\":\"blocName;blocId\"},\"1101\":{\"id\":1101,\"text\":\"团长转让\",\"serverParameter\":\"\"},\"1102\":{\"id\":1102,\"text\":\"由于军团长7天未上线，团长已自动转让。\",\"serverParameter\":\"\"},\"1103\":{\"id\":1103,\"text\":\"团长转让\",\"serverParameter\":\"\"},\"1104\":{\"id\":1104,\"text\":\"您所在的军团团长，已经转让给{playerName}.\",\"serverParameter\":\"playerName\"},\"1105\":{\"id\":1105,\"text\":\"军团逐出\",\"serverParameter\":\"\"},\"1106\":{\"id\":1106,\"text\":\"很遗憾，你被军