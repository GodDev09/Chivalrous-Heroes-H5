l\":60,\"cache\":[\"forge\"]},\"110\":{\"textLevel\":110,\"cache\":[\"bag\"]},\"150\":{\"textLevel\":150,\"cache\":[\"threeKing\"]},\"730\":{\"textLevel\":730,\"cache\":[\"forge\"]}}","pvpInfo":"{\"3\":{\"id\":3,\"sceneRid\":\"S003\",\"wave\":{\"1\":{\"round\":20}}},\"17\":{\"id\":17,\"sceneRid\":\"S003\",\"wave\":{\"1\":{\"round\":20}}},\"18\":{\"id\":18,\"sceneRid\":\"S003\",\"wave\":{\"1\":{\"round\":20}}},\"28\":{\"id\":28,\"sceneRid\":\"S003\",\"wave\":{\"1\":{\"round\":20}}},\"45\":{\"id\":45,\"sceneRid\":\"S003\",\"wave\":{\"1\":{\"round\":20}}},\"67\":{\"id\":67,\"sceneRid\":\"S003\",\"wave\":{\"1\":{\"round\":20}}},\"74\":{\"id\":74,\"sceneRid\":\"S003\",\"wave\":{\"1\":{\"round\":20}}},\"81\":{\"id\":81,\"sceneRid\":\"S003\",\"wave\":{\"1\":{\"round\":20}}}}","questionnaire":"{\"1\":{\"id\":1,\"serverType\":0,\"beginTime\":\"2019-03-12 00:00:00\",\"endTime\":\"2019-03-17 23:59:59\",\"day\":0,\"type\":101,\"show\":\"（奉上1000元宝，将择优回访给予额外奖励)\",\"start\":1,\"total\":22},\"2\":{\"id\":2,\"serverType\":0,\"beginTime\":\"2019-03-11 00:00:00\",\"endTime\":\"2019-03-11 23:59:59\",\"day\":0,\"type\":101,\"show\":\"（奉上1000元宝，将择优回访给予额外奖励)\",\"start\":1,\"total\":22},\"3\":{\"id\":3,\"serverType\":0,\"beginTime\":\"2019-03-20 00:00:00\",\"endTime\":\"2019-03-26 23:59:59\",\"day\":0,\"type\":102,\"show\":\"（奉上1000元宝，将择优回访给予额外奖励)\",\"start\":1,\"total\":22}}","questionnaireList":"{\"102\":{\"type\":102,\"id\":{\"1\":{\"problemType\":3,\"limit\":\"1,7\",\"problem\":\"整体而言，您认为《小小三国志》最吸引您的地方是？（可多选）\",\"answerId\":[\"丰富的卡牌收集元素\",\"轻松休闲的挂机玩法\",\"众多角色的养成\",\"三国背景题材\",\"角色技能的策略搭配\",\"精致的游戏画风\",\"其他（选填）\"]},\"2\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"根据您玩到现在的感受，您对本游戏的满意程度如何？（单选）\",\"answerId\":[\"非常满意\",\"比较满意\",\"不好不坏\",\"比较不满意\",\"非常不满意\"]},\"3\":{\"problemType\":3,\"limit\":\"1,11\",\"problem\":\"请问本游戏让您比较满意的地方是？（可多选）\",\"answerId\":[\"游戏玩法有策略感\",\"游戏玩法丰富有趣\",\"战力成长迅速\",\"角色原画精美\",\"战斗画面吸引\",\"休闲挂机的成长方式\",\"材料获取难度比较合理\",\"PVP形式丰富\",\"发电耗热的程度可以接受\",\"游戏加载速度可以接受\",\"其他（选填）\"]},\"4\":{\"problemType\":3,\"limit\":\"1,12\",\"problem\":\"请问本游戏让您不太满意的地方是？（可多选）\",\"answerId\":[\"游戏玩法策略感不足\",\"游戏玩法少\",\"战力成长乏力\",\"角色原画品质差\",\"战斗画面不吸引\",\"挂机形式的成长方式\",\"材料获取难度过高\",\"PVP形式少\",\"没有团战\",\"发热耗电情况不理想\",\"游戏加载速度太慢\",\"其他（选填）\"]},\"5\":{\"problemType\":3,\"limit\":\"1,13\",\"problem\":\"最近一个月，您还玩过以下哪些H5游戏？（可多选）\",\"answerId\":[\"征服猫星/海盗来了/梦想海岛王\",\"乱世三国志/乱戳三国\",\"我的帝国\",\"传奇来了/沙巴克传奇/屠龙破晓/决战沙城/大天使之剑H5\",\"大圣轮回/大圣觉醒/西游七十二变\",\"三生三世十里桃花/斗罗大陆/江湖侠客令/纵剑仙界\",\"江山美人\",\"妖怪宝可萌/妖怪金手指/宝贝星球\",\"全民穿越之宫\",\"欢乐斗地主/天天斗地主/途游斗地主\",\"头脑王者/欢乐球球/全民切西瓜/丛林大乱斗/消灭病毒\",\"幻城/绯雨骑士团\",\"其他（选填）\"]},\"6\":{\"problemType\":3,\"limit\":\"1,14\",\"problem\":\"最近一个月，您还玩过以下哪些手游？（可多选）\",\"answerId\":[\"剑侠情缘、倩女幽魂、楚留香、天龙八部、斗破苍穹:斗帝之路、风之大陆\",\"梦幻西游、大话西游、神武3、问道、梦幻诛仙\",\"王者荣耀、决战平安京\",\"侍魂：胧月传说、龙之谷\",\"明日之后\",\"刺激战场、荒野行动、全军出击、穿越火线\",\"三国群英传-霸王之业、乱世王者、率土之滨、部落冲突、红警OL、王国纪元\",\"少年三国志、魔灵召唤、三国杀名将传、阴阳师\",\"梦幻模拟战、圣斗士星矢、七龙珠爆裂激战、拳皇98、火影忍者OL\",\"崩坏3、碧蓝航线、电击文库：零境交错、Fate/Grand Order\",\"FIFA足球世界、实况足球、最强NBA\",\"苍之纪元、放置奇兵\",\"欢乐斗地主、腾讯欢乐麻将、JJ斗地主\",\"最近没有玩过手机APP游戏\",\"其他（选填）\"]},\"7\":{\"problemType\":3,\"limit\":\"1,7\",\"problem\":\"您一般选择在什么时候在手机上玩游戏？（可多选）\",\"answerId\":[\"上/下班或上/下学的路上\",\"等待的时间（如等人、排队等）\",\"工作日/上学的午休/课间时间\",\"晚饭后的娱乐时间\",\"睡前的一小段时间\",\"和朋友聚会的时候\",\"其他（选填）\"]},\"8\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"最近三个月，您平均在手机上玩游戏的频率是？（单选）\",\"answerId\":[\"几乎每天都玩\",\"一周3~5天\",\"一周1~2天\",\"不会每周都玩\"]},\"9\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"最近三个月，您平均每天在手机上玩游戏的时间为多久？（单选）\",\"answerId\":[\"1小时或以下\",\"2-3小时\",\"3小时或以上\"]},\"10\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"最近三个月，您平均每个月在手机上玩游戏的花费大约是多少？（单选）\",\"answerId\":[\"没有花费\",\"100元以下\",\"100-300元\",\"300-500元\",\"500-1000元\",\"1000-1500元\",\"1500-2000元\",\"2000-3000元\",\"3000-5000元\",\"5000-10000元\",\"10000-20000元\",\"20000-50000元\",\"50000元以上\",\"不方便透露\"]},\"11\":{\"problemType\":2,\"limit\":\"1,2\",\"problem\":\"以下故事背景中，您更喜欢哪种？（限选两项）\",\"answerId\":[\"你是守护魔法遗迹的龙骑士，为抵御恶魔们的入侵，与各种族英雄联合对抗敌人\",\"你化身为仙剑奇侠传中的李逍遥，陪伴灵儿寻找亲人，在仙侠世界中尽显侠骨柔情\",\"你是宠物小精灵世界中的训练师，为成为最强训练师，在旅行中捕获精灵、收集道馆徽章\",\"你是二战时期的联盟舰队指挥官，为恢复世界秩序，与法西斯集团展开海上决战\",\"你是生活在魔法大陆的冒险者，为探索大陆的未解之谜，与伙伴们一起踏上旅程\",\"你是穿越到西游世界的救世英雄，为拯救乱世，与孙悟空等角色并肩斩妖除魔、重编经典\",\"以上都不喜欢\"]},\"12\":{\"problemType\":2,\"limit\":\"1,2\",\"problem\":\"以下场景风格中，您更喜欢哪种？（限选两项）\",\"answerId\":[\"西游\",\"苍之纪元\",\"口袋妖怪\",\"仙侠\",\"刀塔\",\"以上都不喜欢\"]},\"13\":{\"problemType\":2,\"limit\":\"1,2\",\"problem\":\"以下人物风格中，您更喜欢哪种？（限选两项）\",\"answerId\":[\"苍之纪元\",\"仙侠\",\"口袋妖怪\",\"西游\",\"刀塔\",\"以上都不喜欢\"]},\"14\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"您目前使用的手机品牌是？（单选）\",\"answerId\":[\"华为\",\"小米 \",\"三星\",\"OPPO\",\"Vivo\",\"魅族\",\"联想\",\"苹果\",\"其他（选填）\"]},\"15\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"您目前使用的手机，购买时花费的价格大概是？（单选）\",\"answerId\":[\"1000元以下\",\"1000-3000元\",\"3001-5000元\",\"5000元及以上\",\"记不清楚了\"]},\"16\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"请问您的性别？ （单选）\",\"answerId\":[\"男\",\"女\"]},\"17\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"请问您的年龄？ （单选）\",\"answerId\":[\"12岁及以下\",\"13-17岁\",\"18-23岁\",\"24-28岁\",\"29-35岁\",\"36-45岁\",\"46岁及以上\"]},\"18\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"请问您的教育程度？ （单选）\",\"answerId\":[\"初中及以下\",\"高中\",\"中专/技校\",\"大专\",\"本科\",\"硕士及以上\"]},\"19\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"请问您的职业？（单选）\",\"answerId\":[\"在校高中、初中、小学生\",\"在校大学生\",\"政府/机关干部/公务员\",\"企业管理者（包括基层及中高层管理者）\",\"普通职员（办公室/写字楼工作人员）\",\"专业人员（如医生/律师/文体/记者/老师等）\",\"普通工人（如工厂工人/体力劳动者等）\",\"商业服务业职工（如销售人员/商店职员/服务员）\",\"个体经营者/承包商\",\"自由职业者\",\"农林牧渔劳动者\",\"退休\",\"暂无职业\",\"其他\"]},\"20\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"您最近半年生活时间最长的城市是？（单选）\",\"answerId\":[\"北京、上海、广州、深圳、杭州\",\"其他各省会城市及直辖市\",\"地级城市\",\"县级城市\",\"乡/村/镇\",\"不清楚\"]},\"21\":{\"problemType\":1,\"limit\":\"\",\"problem\":\"你的个人平均月可支配收入大概是？（学生指月可支配费用）（单选）\",\"answerId\":[\"500元以下\",\"500-1000元\",\"1001-1500元\",\"1501-2000元\",\"2001-3000元\",\"3001-5000元\",\"5001-8000元\",\"8001-10000元\",\"10001-20000元\",\"20000元以上\",\"不方便透露\"]},\"22\":{\"problemType\":4,\"limit\":\"\",\"problem