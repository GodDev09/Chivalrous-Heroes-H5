,\"text\":\"关注有礼\",\"serverParameter\":\"\"},\"111\":{\"id\":111,\"text\":\"谢谢你关注公众号，请查收您的关注奖励。\",\"serverParameter\":\"\"},\"112\":{\"id\":112,\"text\":\"删档充值返利\",\"serverParameter\":\"\"},\"113\":{\"id\":113,\"text\":\"感谢您在删档测试服中的大力支持，为您返还充值元宝、VIP经验、充值额度如下，祝您游戏愉快！\",\"serverParameter\":\"\"},\"114\":{\"id\":114,\"text\":\"神器开启\",\"serverParameter\":\"\"},\"115\":{\"id\":115,\"text\":\"恭喜你在三国志中达到神器章节，为您现献上鬼神剑激活卡，祝您游戏愉快！\",\"serverParameter\":\"\"},\"201\":{\"id\":201,\"text\":\"恭喜{playerName}人品爆发，将橙色武将{fighterName}招致麾下！\",\"serverParameter\":\"playerName;fighterName\"},\"202\":{\"id\":202,\"text\":\"恭喜{playerName}人品爆发，将红色武将{fighterName}招致麾下！\",\"serverParameter\":\"playerName;fighterName\"},\"203\":{\"id\":203,\"text\":\"恭喜{playerName}人品爆发，将天金武将{fighterName}招致麾下！\",\"serverParameter\":\"playerName;fighterName\"},\"204\":{\"id\":204,\"text\":\"恭喜{playerName}人品爆发，将暗金武将{fighterName}招致麾下！\",\"serverParameter\":\"playerName;fighterName\"},\"301\":{\"id\":301,\"text\":\"排行BOSS排名奖\",\"serverParameter\":\"\"},\"302\":{\"id\":302,\"text\":\"{level}级BOSS已被击退，附件为伤害奖励，请查收！\",\"serverParameter\":\"level\"},\"303\":{\"id\":303,\"text\":\"世界BOSS排行奖励\",\"serverParameter\":\"\"},\"304\":{\"id\":304,\"text\":\"恭喜你在世界BOSS中排第{playerNum}名，附件为排名奖励，请查收！\",\"serverParameter\":\"playerNum\"},\"305\":{\"id\":305,\"text\":\"排行BOSS击杀奖励\",\"serverParameter\":\"\"},\"306\":{\"id\":306,\"text\":\"恭喜你击杀{level}级BOSS，附件为击杀奖励，请查收\",\"serverParameter\":\"level\"},\"307\":{\"id\":307,\"text\":\"已族BOSS归属奖励\",\"serverParameter\":\"\"},\"308\":{\"id\":308,\"text\":\"恭喜你击退{level}级异族BOSS，附件为击杀奖励，请查收\",\"serverParameter\":\"level\"},\"309\":{\"id\":309,\"text\":\"{level}级异族BOSS已复活，请各位主公前往平叛。\",\"serverParameter\":\"level\"},\"603\":{\"id\":603,\"text\":\"{des}\",\"serverParameter\":\"des\"},\"701\":{\"id\":701,\"text\":\"恭喜玩家{playerName}提升到VIP{vipLevel}！\",\"serverParameter\":\"playerName;vipLevel\"},\"702\":{\"id\":702,\"text\":\"世界BOSS已经开启了！各路英雄好汉可以前去攻打！\",\"serverParameter\":\"\"},\"703\":{\"id\":703,\"t