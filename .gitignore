# ============================================================
#  Chivalrous-Heroes-H5 (XxSG) — .gitignore
# ============================================================
# QUYẾT ĐỊNH: đưa TOÀN BỘ project lên git, kể cả phpstudy_pro/,
# Java/, database MySQL, log, và file chứa credentials.
# Repo là PRIVATE. Xem cảnh báo ở README §13.
#
# Chỉ loại 2 nhóm duy nhất, vì GitHub chặn cứng file > 100 MB
# và chúng vô giá trị trong version control.
# ============================================================


# ------------------------------------------------------------
# 1. Rác của game khác — 244 MB, 4 file
# ------------------------------------------------------------
# Nội dung là game Cocos2d-x Lua (Tank Hero): luascript/*.lua,
# allianceWar/, arImage/, homeBuilding/. Project này chạy Egret
# + TypeScript, không có Lua runtime. Grep "tankhero"/"luascript"
# trên toàn bộ .php/.js/.json/.html → 0 reference.
# 2 file full/luascript.zip mỗi cái 121,3 MB → vượt giới hạn
# 100 MB/file của GitHub.
wwwroot/tankherocdn/


# ------------------------------------------------------------
# 2. MySQL redo log — 512 MB, 2 file
# ------------------------------------------------------------
# InnoDB redo log, mỗi file đúng 256 MB → vượt 100 MB/file.
# MySQL tự sinh lại khi khởi động, nội dung đổi mỗi lần chạy
# → commit vào git chỉ làm repo phồng vô hạn, không phục hồi
# được gì. Phần còn lại của data/ (ibdata1, *.ibd, *.frm) VẪN
# được đưa lên theo yêu cầu.
phpstudy_pro/Extensions/MySQL5.7.26/data/ib_logfile0
phpstudy_pro/Extensions/MySQL5.7.26/data/ib_logfile1


# ------------------------------------------------------------
# 3. Git nội bộ
# ------------------------------------------------------------
# Đề phòng LFS cache bị commit ngược vào repo.
.git/lfs/


# ============================================================
#  CỐ Ý KHÔNG ignore (trước đây từng bị chặn)
# ============================================================
#   phpstudy_pro/      Nginx + MySQL + PHP + Redis + data DB thật
#   Java/              JDK/JRE 1.8.0_181 + [99]C.exe 68 MB
#   cfr.jar            CFR Java decompiler
#   **/props/*.properties    ⚠️ mật khẩu MySQL/Redis/JMX, secretKey
#   **/db.php, global/config.php  ⚠️ mật khẩu MySQL root
#   log/, gamelog/, *.log     log runtime
#   *.bak, *.7z, *.zip        backup và archive
#   .idea/                    cấu hình IDE
#   *.class                   output đã compile
# ============================================================
